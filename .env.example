# ===== Application =====
APP_NAME=CloudPivot
APP_ENV=development
APP_DEBUG=true
APP_SECRET_KEY=change-me-to-a-random-secret-key
APP_ACCESS_TOKEN_EXPIRE_MINUTES=480
APP_REFRESH_TOKEN_EXPIRE_DAYS=7

# ===== Database =====
DATABASE_URL=postgresql+asyncpg://cloudpivot:cloudpivot@localhost:5432/cloudpivot

# ===== Redis =====
REDIS_URL=redis://localhost:6379/0

# ===== SMTP =====
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=noreply@example.com
SMTP_PASSWORD=your-smtp-password
SMTP_FROM=CloudPivot <noreply@example.com>

# ===== WebSSH =====
WEBSSH_SSH_TIMEOUT=30
WEBSSH_MAX_SESSIONS_PER_USER=5

# ===== Agent =====
AGENT_SECRET_KEY=agent-secret-key-change-me

# ===== Docker =====
DOCKER_HOST=unix:///var/run/docker.sock

# ===== Logging =====
LOG_LEVEL=INFO

# ===== Default Admin =====
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_ADMIN_EMAIL=admin@cloudpivot.localhost
